# Скопируйте в .env для локального запуска. На Netlify/Vercel задайте эти же переменные в настройках проекта.
# Никогда не добавляйте настоящие ключи в репозиторий.

# Resend — отправка писем (https://resend.com/api-keys)
RESEND_API_KEY=re_xxxxxxxxxxxxxxxx
# Куда приходят брифы (можно несколько через запятую)
BRIEF_EMAIL_TO=team@prodigi.example
# От кого: адрес на домене, подтверждённом в Resend
BRIEF_EMAIL_FROM="Prodigi Brief <brief@prodigi.example>"

# Supabase — база брифов и файлы (Project Settings → API)
SUPABASE_URL=https://xxxxxxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...
SUPABASE_BUCKET=brief-files

# Необязательные настройки
# IP_HASH_SALT=любая-случайная-строка
# ALLOWED_ORIGINS=https://brief.prodigi.example
# MIN_FILL_SECONDS=20
# MAX_SUBMISSIONS_PER_HOUR=5
# MAX_UPLOADS_PER_HOUR=40
# FILE_LINK_DAYS=30
